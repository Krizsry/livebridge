# --- Secrets: never commit (rule 1) ---
# .mcp.json holds a Supabase PERSONAL ACCESS TOKEN (sbp_...), which is
# account-level - broader than a service role key. It must never be committed.
.mcp.json

# Live environment file - stream keys, passphrases, Supabase service role key.
.env
.env.local

# TLS private keys and certs generated by scripts/setup.ps1.
nginx/certs/

# --- Dependencies / build output ---
node_modules/
dashboard/dist/
backend/node_modules/
dashboard/node_modules/

# --- Runtime data ---
srs/objs/
srs/logs/
data/
hls/
*.log

# --- Editor / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# Timestamped .env backups from in-place secret rotation - contain live secrets.
.env.bak-*

# Migration bundle from scripts/export-config.ps1 - contains live secrets.
livebridge-migration-*/
livebridge-migration-*.zip
