# =============================================================================
# Live Bridge — environment template
# =============================================================================
# Copy to .env and fill in real values:   cp .env.example .env
# Generate strong secrets with:           ./scripts/gen-secrets.sh
#
# NEVER commit .env. NEVER put any of these values in the frontend bundle.
# Every variable below is read by the BACKEND or by an infrastructure container.
# The dashboard (browser) receives NONE of them.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployment identity
# -----------------------------------------------------------------------------
# Public hostname the dashboard is served on. Used for the TLS cert and for the
# connection examples printed in the dashboard UI.
LIVEBRIDGE_HOST=stream.example.com

# Public IP or hostname that encoders (vMix / Kiloview / OBS / Resi) will point
# their SRT and RTMP output at. Often the same as LIVEBRIDGE_HOST.
LIVEBRIDGE_PUBLIC_HOST=stream.example.com

# -----------------------------------------------------------------------------
# SRT ingest (UDP 9000)
# -----------------------------------------------------------------------------
# Listener-wide SRT encryption passphrase. 10-79 characters.
# IMPORTANT: use hex/alphanumeric only. This value is substituted into the SRS
# config by the entrypoint, so shell and regex metacharacters will corrupt it.
# SRS supports ONE passphrase for the whole SRT listener - per-stream identity is
# enforced separately via stream ID + the on_publish hook.
SRT_PASSPHRASE=replace_me_with_32_hex_chars_min10

# AES key length in bytes: 16 (AES-128), 24 (AES-192) or 32 (AES-256).
SRT_PBKEYLEN=16

# Target SRT latency in milliseconds. 120-200 for good networks,
# 300-1000 for lossy/long-haul links. Must be >= the encoder's latency setting.
SRT_LATENCY_MS=300

# -----------------------------------------------------------------------------
# Stream authorisation
# -----------------------------------------------------------------------------
# What to do when a publisher connects, Supabase is unreachable, AND the
# in-memory key cache is empty (cold start during an outage).
#   open   = admit the publisher and log at `critical`  (ingest never dies)
#   closed = reject the publisher                        (strict, but an outage
#            during a cold start will block your show)
# The cache means this only ever applies to a cold start; a warm backend keeps
# authorising from its last-known key list.
AUTH_FAILURE_MODE=open

# How often (seconds) to refresh the registered-stream-key cache from Supabase.
KEY_CACHE_REFRESH_SEC=60

# -----------------------------------------------------------------------------
# Supabase (BACKEND ONLY - never expose to the browser)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE ROLE key. This bypasses RLS. It must exist only here, on the backend.
# If this ever reaches the frontend, anyone can read and write every table.
SUPABASE_SERVICE_ROLE_KEY=replace_me_with_service_role_key

# Optional: leave blank to disable Supabase entirely. Live streaming and the
# live dashboard keep working; history and persisted config become unavailable.
SUPABASE_ENABLED=true

# Seconds the Supabase circuit breaker stays open after repeated failures.
SUPABASE_BREAKER_COOLDOWN_SEC=30

# Consecutive failures before the circuit breaker opens. Lower = degrade sooner
# and stop paying timeouts; higher = tolerate more transient blips.
SUPABASE_BREAKER_THRESHOLD=3

# Per-request timeout in milliseconds for Supabase calls.
SUPABASE_TIMEOUT_MS=5000

# Max queued metadata writes. On overflow the OLDEST are dropped and the event
# is logged - losing a history row is always preferable to stalling ingest.
SUPABASE_WRITE_QUEUE_MAX=1000

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
BACKEND_PORT=8000
LOG_LEVEL=info
# How often (ms) to poll the SRS API and push a metrics frame to the dashboard.
POLL_INTERVAL_MS=1000
# Grace period (seconds) after a publisher drops before its stream flips from
# `reconnecting` to `offline`.
RECONNECT_GRACE_SEC=15

# How many 1-second bitrate samples to retain per stream for the dashboard
# sparkline and the session average. 120 = a 2-minute window.
METRIC_HISTORY_LENGTH=120

# -----------------------------------------------------------------------------
# SRS engine (internal network only - these ports are NOT published to the host)
# -----------------------------------------------------------------------------
SRS_API_URL=http://livebridge-srs:1985
SRS_INTERNAL_RTMP=rtmp://livebridge-srs:1935
SRS_HTTP_URL=http://livebridge-srs:8080
SRS_LOG_LEVEL=trace

# Timeout for SRS API calls. Kept short: a slow engine must degrade the stats
# poll, never queue requests up behind it.
SRS_API_TIMEOUT_MS=3000

# Used by the backend when it builds SRT URLs for ingest/egress jobs.
SRS_INTERNAL_SRT_HOST=livebridge-srs
SRS_INTERNAL_SRT_PORT=9000

# -----------------------------------------------------------------------------
# HLS output
# -----------------------------------------------------------------------------
HLS_FRAGMENT_SEC=2
HLS_WINDOW_SEC=12

# -----------------------------------------------------------------------------
# Relay (FFmpeg)
# -----------------------------------------------------------------------------
# Path to the FFmpeg binary. Leave as `ffmpeg` to use the one on PATH (the
# backend image installs it). Override only for a custom build.
FFMPEG_PATH=ffmpeg

# Max simultaneous outbound relays.
RELAY_MAX_CONCURRENT=16
# Backoff bounds (ms) for restarting a crashed relay.
RELAY_BACKOFF_MIN_MS=1000
RELAY_BACKOFF_MAX_MS=30000

# -----------------------------------------------------------------------------
# Host port mapping (published ports - keep to these three)
# -----------------------------------------------------------------------------
HOST_SRT_PORT=9000
HOST_RTMP_PORT=1935
HOST_HTTPS_PORT=443

# Which host interface Docker publishes each port on. This is only the FIRST of
# three gates between a remote contributor and the server - Windows Firewall and
# the router's NAT forward must also allow the port. See PORT_FORWARDING.md, and
# run scripts/setup-port-forwarding.ps1 to configure the firewall and print the
# router rules.
#
#   0.0.0.0    all interfaces - reachable from the LAN, and from the internet if
#              the firewall and the router forward allow it
#   127.0.0.1  loopback only - reachable from this PC and nothing else

# Ingest ports. Set to 0.0.0.0 to accept contributors from outside the LAN.
# Both are authenticated: SRT by the listener passphrase plus the on_publish
# stream-key check, RTMP by the stream key alone. RTMP has no transport
# encryption, so its stream key travels in clear - prefer SRT over the internet.
SRT_BIND_ADDR=0.0.0.0
RTMP_BIND_ADDR=0.0.0.0

# Dashboard. There is NO application-level login (requirement 12), so this must
# never be forwarded from the router. 0.0.0.0 here is safe only because the
# firewall rule scopes 443 to the local subnet; use 127.0.0.1 to restrict it to
# this PC, or put it behind a VPN.
HTTPS_BIND_ADDR=0.0.0.0

# -----------------------------------------------------------------------------
# DDNS (Cloudflare) - keeps the ingest hostname pointed at this dynamic IP
# -----------------------------------------------------------------------------
# Used by scripts/ddns-update.ps1. Create the token at
# Cloudflare -> My Profile -> API Tokens -> Create Token -> Edit zone DNS,
# scoped to THIS ZONE ONLY. Never use a Global API Key here.
CLOUDFLARE_API_TOKEN=your-cloudflare-scoped-dns-token
CLOUDFLARE_ZONE=example.com
# The hostname contributors publish to. Must be DNS-only (grey cloud) - the
# Cloudflare proxy cannot carry SRT (UDP) or RTMP, only HTTP/HTTPS.
DDNS_RECORD=stream.example.com

# Serve the SRT passphrase to the dashboard (reveal + copy controls).
# There is NO login on the dashboard, so anyone who can reach it can read the
# passphrase when this is true. Only safe while 443 is LAN-restricted and never
# forwarded from the router. Default false.
EXPOSE_PASSPHRASE_IN_DASHBOARD=false
